{
  "name": "playwright-proxy-sessions",
  "version": "0.1.0",
  "description": "Sticky proxy sessions for Playwright and Puppeteer: one proxy per browser context, retire blocked exits, and match timezone, locale and geolocation to where the proxy exits.",
  "keywords": [
    "playwright",
    "puppeteer",
    "proxy",
    "sticky-session",
    "rotating-proxy",
    "mobile-proxy",
    "residential-proxy",
    "timezone",
    "geolocation",
    "web-scraping"
  ],
  "homepage": "https://github.com/quanticdata-io/playwright-proxy-sessions#readme",
  "bugs": {
    "url": "https://github.com/quanticdata-io/playwright-proxy-sessions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanticdata-io/playwright-proxy-sessions.git"
  },
  "license": "MIT",
  "author": "QuanticData <hello@quanticdata.io>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "playwright": ">=1.40",
    "puppeteer": ">=22"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "playwright": "^1.56.0",
    "puppeteer-core": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
